<section class="hero-section" id="hero-banner">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-pill-badge">
          <span>🌸</span>
          <span>Boutique Handcrafted Keepsakes</span>
        </div>

        <h1 class="hero-title">
          Crafted with Blooms, <br>
          <span class="highlight">Made for Her Heart.</span>
        </h1>

        <p class="hero-subtitle">
          Celebrate friendships, bridal parties, and cherished moments with custom-engraved leather lipstick case keychains, LED compact mirrors, and delicate wildflower keepsakes.
        </p>

        <div class="hero-cta-group">
          <a href="#featured-collection" class="btn btn-primary">
            <span>Shop Custom Gifts</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#water-showcase" class="btn btn-secondary">
            <span>Personalize Lipstick Case</span>
          </a>
        </div>

        <div class="hero-stats-row">
          <div class="stat-item">
            <h4>12,400+</h4>
            <p>Happy Gifting Moments</p>
          </div>
          <div class="stat-item">
            <h4>5.0 ★</h4>
            <p>Etsy Verified Rating</p>
          </div>
          <div class="stat-item">
            <h4>100%</h4>
            <p>Handmade & Custom</p>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-visual-card">
          <div class="hero-img-wrapper">
            <img src="{{ 'hero-bespoke-banner.jpg' | asset_url }}" alt="WrapUpBlooms Luxury Personalized Keepsakes" width="800" height="1000" onerror="this.src='{{ 'hero-banner.jpg' | asset_url }}'">
          </div>

          <div class="hero-floating-floater floating-badge">
            <div class="floater-icon-circle">
              🌸
            </div>
            <div class="floater-text">
              <h5>Free Custom Engraving</h5>
              <p>Add birth month flower & name</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Smooth Undulating Water Wave Divider -->
  <div class="water-wave-divider water-wave-animated" style="margin-top: 4rem;">
    <svg viewBox="0 0 1440 120" fill="none" preserveAspectRatio="none">
      <path d="M0,32L48,42.7C96,53,192,75,288,80C384,85,480,75,576,58.7C672,43,768,21,864,21.3C960,21,1056,43,1152,53.3C1248,64,1344,64,1392,64L1440,64L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z" fill="#FFF0F5"></path>
    </svg>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted with Blooms, Made for Her Heart."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Celebrate friendships, bridal parties, and cherished moments with custom-engraved leather lipstick case keychains, LED compact mirrors, and delicate wildflower keepsakes."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ]
}
{% endschema %}
