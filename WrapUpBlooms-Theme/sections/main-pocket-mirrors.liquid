<section class="page-pocket-mirrors-section" style="padding: 5rem 0; background: var(--bg-cream);">
  <div class="container" style="max-width: 860px; text-align: center; margin-bottom: 3.5rem;">
    <span class="section-subtitle-pill">Signature Collection</span>
    <h1 class="section-title" style="font-size: 3.2rem; margin-bottom: 1.25rem;">
      Custom Engraved Pocket & LED Compact Mirrors
    </h1>
    <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2rem;">
      Engineered for effortless purse glamour and heartfelt gifting. Each compact is individually laser-etched with delicate birth flowers, initials, and bespoke messages by our New Hampshire engraving partners.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="#mirrors-catalog" class="btn btn-primary"><span>Explore Mirror Models</span></a>
      <a href="tel:9782338050" class="btn btn-secondary"><span>Call (978) 233-8050 to Order</span></a>
    </div>
  </div>

  <!-- Engineering Specs Grid -->
  <div class="container" style="margin-bottom: 4rem;">
    <div style="background: #FFF; padding: 3rem; border-radius: 32px; border: 1.5px solid var(--border-delicate); box-shadow: var(--shadow-soft);">
      <div class="section-header-center" style="margin-bottom: 2.5rem;">
        <span class="section-subtitle-pill">Artisan Engineering</span>
        <h2 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--primary-deep); margin-bottom: 0.5rem;">Why Our Compact Mirrors Stand Out</h2>
        <p>A touch of everyday luxury, designed to fit cleanly inside evening clutches, totes, and cosmetic organizers.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
        <div style="background: var(--bg-cream); padding: 1.75rem; border-radius: 20px; border: 1px solid var(--border-delicate); text-align: center;">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">✨</div>
          <h4 style="font-family: var(--font-serif); font-size: 1.15rem; color: var(--primary-deep); margin-bottom: 6px;">Halo Ring LED</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6;">Soft, daylight-balanced ring light for crisp touch-ups in dimly lit evening venues, restaurants, and vehicles.</p>
        </div>

        <div style="background: var(--bg-cream); padding: 1.75rem; border-radius: 20px; border: 1px solid var(--border-delicate); text-align: center;">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🔍</div>
          <h4 style="font-family: var(--font-serif); font-size: 1.15rem; color: var(--primary-deep); margin-bottom: 6px;">1x & 2x Dual Glass</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6;">One distortion-free optical mirror and one 2x magnification mirror for eyeliner, mascara, and lipstick precision.</p>
        </div>

        <div style="background: var(--bg-cream); padding: 1.75rem; border-radius: 20px; border: 1px solid var(--border-delicate); text-align: center;">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🌿</div>
          <h4 style="font-family: var(--font-serif); font-size: 1.15rem; color: var(--primary-deep); margin-bottom: 6px;">Permanent Laser Etching</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6;">Deep, indelible laser engraving by our New Hampshire partner that never peels, rubs off, or fades with daily friction.</p>
        </div>

        <div style="background: var(--bg-cream); padding: 1.75rem; border-radius: 20px; border: 1px solid var(--border-delicate); text-align: center;">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🎁</div>
          <h4 style="font-family: var(--font-serif); font-size: 1.15rem; color: var(--primary-deep); margin-bottom: 6px;">Ready-to-Gift Packaging</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6;">Arrives nestled in our signature blush presentation box tied with a satin ribbon and dried botanical insert.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Mirrors Product Grid -->
  <div class="container" id="mirrors-catalog">
    <div class="section-header-center">
      <span class="section-subtitle-pill">Curated Selection</span>
      <h2 class="section-title">Explore Our Compact Mirror Designs</h2>
      <p>Choose your favorite finish and customize with your birth month flower, monogram, or custom text.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-top: 2rem;">
      <div class="product-card">
        <div class="product-card-media">
          <span class="product-badge-sale">Best Seller</span>
          <span class="product-badge-custom">LED Illuminated</span>
          <img src="{{ 'bespoke-compact-mirror.jpg' | asset_url }}" alt="Rose Gold LED Compact Mirror" onerror="this.src='{{ 'product-compact-mirror.jpg' | asset_url }}'">
        </div>
        <div class="product-rating">★★★★★ <span style="font-size: 0.75rem; color: var(--text-muted);">(5.0 &bull; 619 reviews)</span></div>
        <h3 class="product-title">Rose Gold Halo LED Pocket Compact Mirror</h3>
        <p class="product-tagline">Dual 1x/2x magnification &bull; USB-C rechargeable</p>
        <div class="product-price-row">
          <div class="price-container">
            <span class="current-price">$28.50</span>
            <span class="compare-price">$35.00</span>
          </div>
          <a href="/pages/contact" class="btn-quick-add">🌸 Personalize</a>
        </div>
      </div>

      <div class="product-card">
        <div class="product-card-media">
          <span class="product-badge-custom">Laser Etched</span>
          <img src="{{ 'product-compact-mirror.jpg' | asset_url }}" alt="Vintage Botanical Pocket Mirror">
        </div>
        <div class="product-rating">★★★★★ <span style="font-size: 0.75rem; color: var(--text-muted);">(5.0 &bull; 480 reviews)</span></div>
        <h3 class="product-title">Vintage Botanical Floral Pocket Mirror</h3>
        <p class="product-tagline">Solid alloy metal casing &bull; Antique floral wreath</p>
        <div class="product-price-row">
          <div class="price-container">
            <span class="current-price">$22.00</span>
            <span class="compare-price">$28.00</span>
          </div>
          <a href="/pages/contact" class="btn-quick-add">🌸 Personalize</a>
        </div>
      </div>

      <div class="product-card">
        <div class="product-card-media">
          <span class="product-badge-sale">Bridal Favorite</span>
          <span class="product-badge-custom">Mother of the Bride</span>
          <img src="{{ 'bespoke-compact-mirror.jpg' | asset_url }}" alt="Mother of the Bride Keepsake Mirror" onerror="this.src='{{ 'product-compact-mirror.jpg' | asset_url }}'">
        </div>
        <div class="product-rating">★★★★★ <span style="font-size: 0.75rem; color: var(--text-muted);">(5.0 &bull; 340 reviews)</span></div>
        <h3 class="product-title">Mother of the Bride / Maid of Honor Keepsake Mirror</h3>
        <p class="product-tagline">Custom wedding date &bull; Script calligraphy</p>
        <div class="product-price-row">
          <div class="price-container">
            <span class="current-price">$26.00</span>
            <span class="compare-price">$32.00</span>
          </div>
          <a href="/pages/contact" class="btn-quick-add">🌸 Personalize</a>
        </div>
      </div>

      <div class="product-card">
        <div class="product-card-media">
          <span class="product-badge-custom">Built-In Mirror</span>
          <img src="{{ 'bespoke-lipstick-keychain.jpg' | asset_url }}" alt="Leather Lipstick Case Keychain with Mirror" onerror="this.src='{{ 'product-lipstick-case.jpg' | asset_url }}'">
        </div>
        <div class="product-rating">★★★★★ <span style="font-size: 0.75rem; color: var(--text-muted);">(5.0 &bull; 842 reviews)</span></div>
        <h3 class="product-title">Leather Lipstick Case Keychain with Interior Mirror</h3>
        <p class="product-tagline">Vegan leather sleeve &bull; Built-in touch-up mirror</p>
        <div class="product-price-row">
          <div class="price-container">
            <span class="current-price">$24.00</span>
            <span class="compare-price">$30.00</span>
          </div>
          <a href="/pages/contact" class="btn-quick-add">🌸 Personalize</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Custom CTA Section -->
  <div class="container" style="margin-top: 5rem; text-align: center;">
    <div style="background: #FFF; padding: 3rem; border-radius: 32px; border: 1.5px solid var(--border-delicate); box-shadow: var(--shadow-hover);">
      <h3 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--primary-deep); margin-bottom: 0.75rem;">Need a Custom Bulk Bridal Order or Special Engraving?</h3>
      <p style="font-size: 1rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto 1.75rem;">We offer special bridal party discounts on 5+ mirrors with matching personalized gift boxes.</p>
      <a href="/pages/contact" class="btn btn-primary" style="padding: 16px 36px;">
        <span>Contact Us Now to Get Your Mirror</span>
      </a>
    </div>
  </div>
</section>

