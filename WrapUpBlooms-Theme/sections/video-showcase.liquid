<!-- Video Showcase: Halo Light in Action -->
<section class="video-showcase-section" style="padding: 4.5rem 0; background: radial-gradient(circle at 50% 30%, #FFF0F4 0%, #FFF9F5 65%, #FFF5ED 100%);">
  <div class="container">
    <div class="video-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center;">
      
      <!-- Video Player Card -->
      <div style="position: relative; border-radius: 28px; overflow: hidden; box-shadow: 0 20px 45px rgba(196, 123, 137, 0.22); border: 2px solid var(--accent-rose-gold); background: #000; aspect-ratio: 9/16; max-height: 520px; margin: 0 auto; width: 100%; max-width: 320px;">
        <video id="halo-demo-video" src="{{ 'led-mirror-demo.mp4' | asset_url }}" autoplay loop muted playsinline controls style="width: 100%; height: 100%; object-fit: cover;">
          Your browser does not support video playback.
        </video>
        <div style="position: absolute; top: 14px; left: 14px; background: rgba(0,0,0,0.65); color: #FFF; font-size: 0.72rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; backdrop-filter: blur(8px); display: flex; align-items: center; gap: 6px;">
          <span style="width: 8px; height: 8px; background: #10B981; border-radius: 50%; display: inline-block;"></span>
          LIVE DEMO
        </div>
      </div>

      <!-- Video Description & Details -->
      <div>
        <span class="section-subtitle-pill">{{ section.settings.subtitle | default: 'Artisan Video Showcase' }}</span>
        <h2 class="section-title" style="margin-bottom: 1rem;">{{ section.settings.title | default: 'See the Halo Light in Action' }}</h2>
        <p style="font-size: 1.05rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
          {{ section.settings.description | default: 'Watch how our daylight-balanced LED halo ring illuminates with a gentle touch. Engineered for flawless makeup touch-ups in dimly lit restaurants, evening events, and on-the-go purse glamour.' }}
        </p>

        <div style="display: grid; gap: 1rem; margin-bottom: 2rem;">
          <div style="display: flex; gap: 14px; align-items: flex-start;">
            <span style="font-size: 1.4rem;">💡</span>
            <div>
              <strong style="color: var(--primary-deep); font-size: 0.95rem;">Soft Daylight Halo Ring</strong>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin: 2px 0 0;">Gentle illumination that evenly lights the face without glare or harsh shadows.</p>
            </div>
          </div>

          <div style="display: flex; gap: 14px; align-items: flex-start;">
            <span style="font-size: 1.4rem;">🔍</span>
            <div>
              <strong style="color: var(--primary-deep); font-size: 0.95rem;">Dual 1x & 2x Optical Glass</strong>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin: 2px 0 0;">One standard distortion-free mirror and one magnified mirror for fine eyeliner & lip detail.</p>
            </div>
          </div>

          <div style="display: flex; gap: 14px; align-items: flex-start;">
            <span style="font-size: 1.4rem;">🌸</span>
            <div>
              <strong style="color: var(--primary-deep); font-size: 0.95rem;">Laser-Etched Birth Flower & Name</strong>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin: 2px 0 0;">Deep permanent engraving that never rubs off, peels, or fades with daily handbag friction.</p>
            </div>
          </div>
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="/pages/pocket-mirrors" class="btn btn-primary">
            <span>Personalize Your LED Mirror</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="tel:9782338050" class="btn btn-secondary">
            <span>Order by Phone: (978) 233-8050</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video Showcase",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Pill",
      "default": "Artisan Video Showcase"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "See the Halo Light in Action"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Watch how our daylight-balanced LED halo ring illuminates with a gentle touch."
    }
  ],
  "presets": [
    {
      "name": "Video Showcase"
    }
  ]
}
{% endschema %}
