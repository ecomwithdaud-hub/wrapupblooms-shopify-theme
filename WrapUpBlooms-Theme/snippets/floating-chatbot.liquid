<!-- Floating Boutique Concierge Chatbot ("Get Yours Now!") -->
<div id="wrapup-chatbot-root" class="wrapup-chatbot-root">
  <!-- Floating Pinkish Trigger Button -->
  <button id="chatbot-toggle-btn" class="chatbot-floating-pill" aria-label="Open WrapUpBlooms Live Assistant">
    <span class="chatbot-pill-icon">🌸</span>
    <span class="chatbot-pill-text">
      <span class="chatbot-pill-sub">Need Help?</span>
      <span class="chatbot-pill-title">Get Yours Now! 💬</span>
    </span>
    <span class="chatbot-pulse-dot"></span>
  </button>

  <!-- Interactive Chat Window -->
  <div id="chatbot-window" class="chatbot-window" role="dialog" aria-modal="true" aria-label="WrapUpBlooms Boutique Chat Assistant">
    <div class="chatbot-header">
      <div class="chatbot-header-info">
        <div class="chatbot-avatar">🌸</div>
        <div>
          <h3 class="chatbot-title">WrapUpBlooms Studio</h3>
          <span class="chatbot-status">Saddam & Naina &bull; Online Now</span>
        </div>
      </div>
      <button id="chatbot-close-btn" class="chatbot-close-btn" aria-label="Close Chat">✕</button>
    </div>

    <div id="chatbot-body" class="chatbot-body">
      <div class="chat-bubble bot">
        🌸 <strong>Hello darling!</strong> Welcome to WrapUpBlooms. We handcraft laser-engraved compact mirrors, lipstick keychains, and velvet jewelry organizers.
      </div>
      <div class="chat-bubble bot">
        How can we help you personalize her keepsake today? Click a prompt below or ask us anything! 💖
      </div>

      <div class="chatbot-quick-chips">
        <button type="button" class="chatbot-chip">🪞 Order Custom Mirror</button>
        <button type="button" class="chatbot-chip">💄 Lipstick Case Keychain</button>
        <button type="button" class="chatbot-chip">💍 Velvet Jewelry Box</button>
        <button type="button" class="chatbot-chip">🌸 12 Birth Flowers Guide</button>
        <button type="button" class="chatbot-chip">✨ Bridal Party Discounts</button>
        <button type="button" class="chatbot-chip">📞 Call/Text: (978) 233-8050</button>
      </div>
    </div>

    <div class="chatbot-footer">
      <form id="chatbot-form" class="chatbot-form">
        <input type="text" id="chatbot-input" class="chatbot-input" placeholder="Type your question or name here..." autocomplete="off">
        <button type="submit" class="chatbot-send-btn" aria-label="Send Message">➤</button>
      </form>
      <div class="chatbot-cta-row">
        <a href="/pages/contact" class="chatbot-direct-cta">👉 Contact Us Now to Get Your Mirror</a>
      </div>
    </div>
  </div>
</div>
