<section class="page-jewelry-boxes-section" style="padding: 5rem 0; background: var(--bg-cream);">
  <div class="container" style="max-width: 860px; text-align: center; margin-bottom: 3.5rem;">
    <span class="section-subtitle-pill">Bridal & Keepsake Collection</span>
    <h1 class="section-title" style="font-size: 3.2rem; margin-bottom: 1.25rem;">
      Personalized Velvet Travel Jewelry Boxes
    </h1>
    <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2rem;">
      Keep cherished rings, earrings, and heirloom necklaces beautifully untangled on the go. Lined with ultra-soft blush velvet and customized with her gold monogram and birth flower.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="#boxes-catalog" class="btn btn-primary"><span>View Jewelry Organizers</span></a>
      <a href="/pages/contact" class="btn btn-secondary"><span>Contact Us Now to Get Your Mirror</span></a>
    </div>
  </div>

  <!-- Interior Anatomy Section -->
  <div class="container" style="margin-bottom: 5rem;">
    <div style="background: #FFF; padding: 3.5rem; border-radius: 32px; border: 1.5px solid var(--border-delicate); box-shadow: var(--shadow-soft);">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
        <div style="position: relative; border-radius: 24px; overflow: hidden; box-shadow: var(--shadow-hover);">
          <img src="{{ 'product-jewelry-box.jpg' | asset_url }}" alt="Velvet Jewelry Case Interior" style="width: 100%; height: 100%; object-fit: cover;">
          <div style="position: absolute; bottom: 16px; left: 16px; right: 16px; background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); padding: 14px 18px; border-radius: 14px; border: 1px solid var(--border-delicate);">
            <strong>Travel Dimensions: 4" x 4" x 2"</strong> &bull; Easily slips into luggage or purse
          </div>
        </div>

        <div>
          <span class="section-subtitle-pill">Smart Organization</span>
          <h2 style="font-size: 2.2rem; font-family: var(--font-serif); color: var(--primary-deep); margin-bottom: 1.25rem; line-height: 1.2;">
            Designed to Protect What You Cherish Most
          </h2>
          <p style="font-size: 0.95rem; line-height: 1.8; color: var(--text-secondary); margin-bottom: 1.5rem;">
            No more tangled chains or lost earring backs. Each WrapUpBlooms travel case is partitioned to securely hold everyday jewelry essentials with dedicated plush velvet compartments.
          </p>

          <ul style="list-style: none; display: flex; flex-direction: column; gap: 1rem; color: var(--text-secondary); font-size: 0.95rem; padding: 0;">
            <li style="display: flex; align-items: center; gap: 10px;">
              <span style="color: var(--primary-rose); font-size: 1.2rem;">🌸</span>
              <span><strong>6 Padded Ring Slots:</strong> Cushioned rows keep rings and bands snug.</span>
            </li>
            <li style="display: flex; align-items: center; gap: 10px;">
              <span style="color: var(--primary-rose); font-size: 1.2rem;">✨</span>
              <span><strong>3 Anti-Tangle Necklace Hooks:</strong> Elasticized pouch prevents pendant knots.</span>
            </li>
            <li style="display: flex; align-items: center; gap: 10px;">
              <span style="color: var(--primary-rose); font-size: 1.2rem;">🌿</span>
              <span><strong>Removable Cross Dividers:</strong> Reconfigure slots for bulkier hoops or lipstick.</span>
            </li>
            <li style="display: flex; align-items: center; gap: 10px;">
              <span style="color: var(--primary-rose); font-size: 1.2rem;">🔒</span>
              <span><strong>Reinforced Gold Alloy Zipper:</strong> Keeps contents locked tight while traveling.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Product Catalog -->
  <div class="container" id="boxes-catalog">
    <div class="section-header-center">
      <span class="section-subtitle-pill">Available Designs</span>
      <h2 class="section-title">Jewelry Boxes & Keepsake Cases</h2>
      <p>Available in soft pastel shades with customized metallic gold monogram script.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-top: 2rem;">
      <div class="product-card">
        <div class="product-card-media">
          <span class="product-badge-sale">Best Seller</span>
          <span class="product-badge-custom">Velvet Monogram</span>
          <img src="{{ 'product-jewelry-box.jpg' | asset_url }}" alt="Personalized Wildflower Velvet Travel Jewelry Box">
        </div>
        <div class="product-rating">★★★★★ <span style="font-size: 0.75rem; color: var(--text-muted);">(5.0 &bull; 412 reviews)</span></div>
        <h3 class="product-title">Soft Cream Wildflower Velvet Travel Jewelry Box</h3>
        <p class="product-tagline">Gold foil initial &bull; Anti-tangle interior</p>
        <div class="product-price-row">
          <div class="price-container">
            <span class="current-price">$32.00</span>
            <span class="compare-price">$40.00</span>
          </div>
          <a href="/pages/contact" class="btn-quick-add">🌸 Personalize</a>
        </div>
      </div>

      <div class="product-card">
        <div class="product-card-media">
          <span class="product-badge-custom">Bridal Suite</span>
          <img src="{{ 'product-bridesmaid-box.jpg' | asset_url }}" alt="Bridesmaid Proposal Deluxe Floral Gift Box">
        </div>
        <div class="product-rating">★★★★★ <span style="font-size: 0.75rem; color: var(--text-muted);">(5.0 &bull; 540 reviews)</span></div>
        <h3 class="product-title">Bridesmaid Proposal Deluxe Keepsake Box Set</h3>
        <p class="product-tagline">Includes mirror + lipstick sleeve + velvet case</p>
        <div class="product-price-row">
          <div class="price-container">
            <span class="current-price">$45.00</span>
            <span class="compare-price">$55.00</span>
          </div>
          <a href="/pages/contact" class="btn-quick-add">🌸 Personalize</a>
        </div>
      </div>

      <div class="product-card">
        <div class="product-card-media">
          <span class="product-badge-sale">Keepsake Decor</span>
          <img src="{{ 'product-bear-puzzle.jpg' | asset_url }}" alt="Wooden Bear Family Keepsake Puzzle">
        </div>
        <div class="product-rating">★★★★★ <span style="font-size: 0.75rem; color: var(--text-muted);">(5.0 &bull; 928 reviews)</span></div>
        <h3 class="product-title">Handcrafted Wooden Family Keepsake Puzzle</h3>
        <p class="product-tagline">Solid beechwood &bull; Custom etched names</p>
        <div class="product-price-row">
          <div class="price-container">
            <span class="current-price">$39.00</span>
            <span class="compare-price">$48.00</span>
          </div>
          <a href="/pages/contact" class="btn-quick-add">🌸 Personalize</a>
        </div>
      </div>

      <div class="product-card">
        <div class="product-card-media">
          <span class="product-badge-custom">Quilted Velvet</span>
          <img src="{{ 'product-cosmetic-pouch.jpg' | asset_url }}" alt="Custom Monogram Velvet Cosmetic Pouch">
        </div>
        <div class="product-rating">★★★★★ <span style="font-size: 0.75rem; color: var(--text-muted);">(5.0 &bull; 215 reviews)</span></div>
        <h3 class="product-title">Personalized Quilted Velvet Cosmetic Pouch</h3>
        <p class="product-tagline">Gold metal zipper &bull; Embroidered monogram</p>
        <div class="product-price-row">
          <div class="price-container">
            <span class="current-price">$26.00</span>
            <span class="compare-price">$34.00</span>
          </div>
          <a href="/pages/contact" class="btn-quick-add">🌸 Personalize</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Custom CTA Section -->
  <div class="container" style="margin-top: 5rem; text-align: center;">
    <div style="background: #FFF; padding: 3rem; border-radius: 32px; border: 1.5px solid var(--border-delicate); box-shadow: var(--shadow-hover);">
      <h3 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--primary-deep); margin-bottom: 0.75rem;">Planning a Bridal Shower or Bridesmaid Proposal?</h3>
      <p style="font-size: 1rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto 1.75rem;">We provide color-coordinated velvet boxes and personalized compact mirrors for your whole bridal party.</p>
      <a href="/pages/contact" class="btn btn-primary" style="padding: 16px 36px;">
        <span>Contact Us Now to Get Your Mirror</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Jewelry Boxes Page",
  "settings": []
}
{% endschema %}
