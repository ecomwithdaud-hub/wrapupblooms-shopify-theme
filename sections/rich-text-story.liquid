<section class="story-section" id="story" style="padding: 6rem 0; background: #FFFFFF; position: relative;">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; margin-bottom: 4rem;">
      <div style="position: relative; border-radius: 28px; overflow: hidden; box-shadow: var(--shadow-hover);">
        <img src="{{ 'story-artisan-craft.jpg' | asset_url }}" alt="Artisan Craftsmanship at WrapUpBlooms" style="width: 100%; height: 100%; object-fit: cover;">
        <div style="position: absolute; bottom: 20px; left: 20px; right: 20px; background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); padding: 16px 20px; border-radius: 16px; border: 1px solid var(--border-delicate);">
          <div style="font-size: 0.85rem; font-weight: 700; color: var(--primary-deep);">Handcrafted in Small Batches</div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">Each piece laser-etched and packaged with hand-tied satin ribbons.</div>
        </div>
      </div>

      <div>
        <span class="section-subtitle-pill">Our Philosophy</span>
        <h2 style="font-size: 2.85rem; font-family: var(--font-serif); color: var(--primary-deep); margin-bottom: 1.5rem; line-height: 1.2;">
          Every Gift Tells a Story in Full Bloom.
        </h2>
        <p style="font-size: 1.05rem; line-height: 1.8; color: var(--text-secondary); margin-bottom: 1.5rem;">
          At <strong>WrapUpBlooms</strong>, we believe that gifts shouldn't just sit on a shelf &mdash; they should accompany you through everyday adventures. That is why our signature leather lipstick case keychains with mirrors, personalized pocket compacts, and bespoke jewelry boxes are engineered for both daily beauty touch-ups and heartfelt sentimental meaning.
        </p>
        <p style="font-size: 1rem; line-height: 1.8; color: var(--text-secondary); margin-bottom: 2rem;">
          From bridesmaid proposals to birthdays, new mothers, and self-love treats, our botanical birth-month engravings ensure no two pieces are ever identical.
        </p>

        <div style="display: flex; gap: 2rem; align-items: center; border-top: 1px solid var(--border-delicate); padding-top: 1.5rem;">
          <div>
            <div style="font-family: var(--font-serif); font-size: 1.5rem; font-style: italic; color: var(--primary-rose);">WrapUpBlooms Studio</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Artisan Gifting Specialists</div>
          </div>
          <a href="#contact-section" class="btn btn-secondary" style="margin-left: auto;">Contact Us Now to Get Your Mirror</a>
        </div>
      </div>
    </div>

    <!-- Shop Members & Production Partners Section -->
    <div style="background: var(--bg-cream); border-radius: 32px; padding: 3rem; border: 1px solid var(--border-delicate); box-shadow: var(--shadow-soft);">
      <div style="text-align: center; max-width: 650px; margin: 0 auto 2.5rem;">
        <span class="section-subtitle-pill">Meet the Team</span>
        <h3 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--primary-deep); margin-bottom: 0.75rem;">Shop Members & Production Partners</h3>
        <p style="font-size: 0.95rem; color: var(--text-secondary);">The passionate artisans and skilled partners behind every personalized floral keepsake.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
        <!-- Shop Member: Saddam -->
        <div style="background: #FFF; padding: 2rem; border-radius: 24px; border: 1px solid var(--border-delicate); box-shadow: 0 4px 15px rgba(196, 123, 137, 0.06);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 1rem;">
            <div style="width: 50px; height: 50px; border-radius: 50%; background: var(--bg-petal); color: var(--primary-rose); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: bold;">
              S
            </div>
            <div>
              <h4 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--primary-deep); margin-bottom: 2px;">Saddam</h4>
              <span style="font-size: 0.8rem; font-weight: 600; color: var(--primary-rose); text-transform: uppercase; letter-spacing: 0.05em;">Designer, Owner, Curator</span>
            </div>
          </div>
          <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
            Leads creative direction, brand curation, and signature floral designs. Dedicated to ensuring each keepsake reflects timeless romance and premium craftsmanship.
          </p>
        </div>

        <!-- Shop Member: Naina -->
        <div style="background: #FFF; padding: 2rem; border-radius: 24px; border: 1px solid var(--border-delicate); box-shadow: 0 4px 15px rgba(196, 123, 137, 0.06);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 1rem;">
            <div style="width: 50px; height: 50px; border-radius: 50%; background: var(--bg-petal); color: var(--primary-rose); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: bold;">
              N
            </div>
            <div>
              <h4 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--primary-deep); margin-bottom: 2px;">Naina</h4>
              <span style="font-size: 0.8rem; font-weight: 600; color: var(--primary-rose); text-transform: uppercase; letter-spacing: 0.05em;">Designer, Crafter, Customer Service</span>
            </div>
          </div>
          <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
            Specializes in handcrafted assembly, delicate detailing, and personalized client communication to ensure every custom request is handled with genuine care.
          </p>
        </div>

        <!-- Production Partner: Engraving Shop -->
        <div style="background: #FFF; padding: 2rem; border-radius: 24px; border: 1px solid var(--border-delicate); box-shadow: 0 4px 15px rgba(196, 123, 137, 0.06);">
          <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 1rem;">
            <div style="width: 50px; height: 50px; border-radius: 50%; background: var(--bg-blush); color: var(--accent-gold); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
              ⚙️
            </div>
            <div>
              <h4 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--primary-deep); margin-bottom: 2px;">Engraving Shop</h4>
              <span style="font-size: 0.8rem; font-weight: 600; color: var(--primary-dark-rose); text-transform: uppercase; letter-spacing: 0.05em;">Production Partner &bull; NH, United States</span>
            </div>
          </div>
          <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
            A skilled craftsman and trusted partner who handles the physical engraving and localized dispatch for our US-bound orders.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story & Team",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Gift Tells a Story in Full Bloom."
    }
  ],
  "presets": [
    {
      "name": "Story & Team"
    }
  ]
}
{% endschema %}
