<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FFF9F5">
    <title>Opening Soon &ndash; WrapUpBlooms</title>

    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    <style>
      .password-page-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 3rem 1.5rem;
        background: radial-gradient(circle at 50% 20%, #FFF0F4 0%, #FFF9F5 65%, #FFF5ED 100%);
      }
      .password-card {
        background: #ffffff;
        border: 1px solid var(--border-soft);
        border-radius: 24px;
        padding: 3.5rem 2.5rem;
        max-width: 580px;
        width: 100%;
        box-shadow: 0 20px 45px rgba(224, 114, 138, 0.08);
      }
      .password-input-row {
        display: flex;
        gap: 8px;
        margin-top: 1.5rem;
      }
      .password-input {
        flex: 1;
        padding: 14px 18px;
        border-radius: 999px;
        border: 1px solid var(--border-soft);
        font-family: var(--font-sans);
        font-size: 0.95rem;
        outline: none;
      }
      .password-input:focus {
        border-color: var(--primary-rose);
      }
    </style>
  </head>
  <body>
    <div class="password-page-wrapper">
      <div class="password-card">
        <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🌸</div>
        <span class="section-subtitle-pill">In Full Bloom &bull; Opening Soon</span>
        <h1 style="font-family: var(--font-serif); font-size: 2.6rem; color: var(--primary-deep); margin: 1rem 0 0.5rem; font-weight: 700;">
          WrapUpBlooms
        </h1>
        <p style="font-size: 1.05rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2rem;">
          Our boutique is currently curating delicate handcrafted floral keepsakes, personalized leather lipstick keychains, and LED compact mirrors.
        </p>

        {% form 'storefront_password' %}
          {{ form.errors | default_errors }}
          <label for="password" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em;">Enter Store Password</label>
          <div class="password-input-row">
            <input type="password" name="password" id="password" class="password-input" placeholder="Store password" autofocus autocomplete="current-password">
            <button type="submit" class="btn btn-primary" style="padding: 12px 24px;">Enter</button>
          </div>
        {% endform %}

        <div style="margin-top: 2.5rem; pt-3; border-top: 1px solid var(--border-soft); padding-top: 1.5rem; font-size: 0.88rem; color: var(--text-muted);">
          Questions or custom inquiries? Call or text Saddam &amp; Naina at <a href="tel:9782338050" style="color: var(--primary-dark-rose); font-weight: 600;">(978) 233-8050</a>.
        </div>
      </div>
    </div>
  </body>
</html>
